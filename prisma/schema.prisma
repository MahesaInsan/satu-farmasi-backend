// npx prisma generate
// npx prisma db push
// Belum baca baca migration cuy nanti gua baca lagi ygy

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_SUPABASE")
  directUrl = env("DIRECT_URL_SUPABASE")
}

model User {
  id                     Int           @id @default(autoincrement())
  nik                    String        @unique
  email                  String        @unique
  password               String
  firstName              String
  lastName               String
  dob                    DateTime
  phoneNum               String
  role                   Role
  is_active              Boolean
  specialist             String?
  sipaNum                String?
  diagnose               Diagnose[]
  pharmacistTransactions Transaction[]
  created_at             DateTime
  updated_at             DateTime      @default(now())
}

model Patient {
  id               Int            @id @default(autoincrement())
  credentialNumber String         @unique
  phoneNum         String
  name             String
  is_active        Boolean
  created_at       DateTime
  updated_at       DateTime       @default(now())
  transaction      Transaction[]
  prescription     Prescription[]
}

model GenericName {
  id         Int        @id @default(autoincrement())
  label      String
  value      String
  is_active  Boolean
  created_at DateTime
  updated_at DateTime   @default(now())
  medicines  Medicine[]
}

model Packaging {
  id         Int        @id @default(autoincrement())
  label      String
  value      String
  is_active  Boolean
  created_at DateTime
  updated_at DateTime   @default(now())
  medicines  Medicine[]
}

model Classification {
  id         Int                         @id @default(autoincrement())
  label      String
  value      String
  is_active  Boolean
  created_at DateTime
  updated_at DateTime                    @default(now())
  medicines  MedicineHasClassification[]
}

model Vendor {
  id               Int               @id @default(autoincrement())
  name             String
  phoneNum         String
  address          String
  city             String
  is_active        Boolean
  created_at       DateTime
  updated_at       DateTime          @default(now())
  receiveMedicines ReceiveMedicine[]
}

model Medicine {
  id               Int                         @id @default(autoincrement())
  code             String
  name             String
  batchCode        String
  genericName      GenericName                 @relation(fields: [genericNameId], references: [id])
  genericNameId    Int
  merk             String
  description      String
  unitOfMeasure    UnitOfMeasure
  classifications  MedicineHasClassification[]
  price            Decimal
  expiredDate      DateTime
  packaging        Packaging                   @relation(fields: [packagingId], references: [id])
  packagingId      Int
  currStock        Int
  minStock         Int
  maxStock         Int
  reservedStock    Int                         @default(0)
  sideEffect       String
  is_active        Boolean
  created_at       DateTime
  updated_at       DateTime                    @default(now())
  receiveMedicines ReceiveMedicine[]
  outputMedicines  OutputMedicine[]
  prescriptions    PrescriptionHasMedicine[]
}

model MedicineHasClassification {
  medicine         Medicine       @relation(fields: [medicineId], references: [id])
  medicineId       Int
  classification   Classification @relation(fields: [classificationId], references: [id])
  classificationId Int

  @@id([medicineId, classificationId])
}

model PrescriptionHasMedicine {
  id             Int          @id @default(autoincrement())
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  prescriptionId Int
  medicine       Medicine?    @relation(fields: [medicineId], references: [id])
  medicineId     Int?
  medicineCode   String
  quantity       Int
  instruction    String
  totalPrice     Decimal
  draft          Boolean
}

model Prescription {
  id           Int                       @id @default(autoincrement())
  patient      Patient                   @relation(fields: [patientId], references: [id])
  patientId    Int
  medicineList PrescriptionHasMedicine[]
  transaction  Transaction?
  diagnose     Diagnose?
  status       Status
  is_active    Boolean
  created_at   DateTime
  updated_at   DateTime                  @default(now())
}

model Diagnose {
  id             Int          @id @default(autoincrement())
  doctor         User         @relation(fields: [doctorId], references: [id])
  doctorId       Int
  title          String
  description    String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  prescriptionId Int          @unique
  is_active      Boolean
  created_at     DateTime
  updated_at     DateTime     @default(now())
}

model Transaction {
  id               Int             @id @default(autoincrement())
  patient          Patient         @relation(fields: [patientId], references: [id])
  patientId        Int
  prescription     Prescription    @relation(fields: [prescriptionId], references: [id])
  prescriptionId   Int             @unique
  pharmacist       User            @relation(fields: [pharmacistId], references: [id])
  pharmacistId     Int
  paymentMethod    PaymentMethod?
  totalPrice       Decimal
  is_active        Boolean
  created_at       DateTime
  updated_at       DateTime        @default(now())
  report           MedicineReport? @relation(fields: [reportId], references: [id])
  reportId         Int?
  physicalReport   PhysicalReport? @relation(fields: [physicalReportId], references: [id])
  physicalReportId Int?            @unique
}

model ReceiveMedicine {
  id             Int             @id @default(autoincrement())
  documentNumber String
  batchCode      String
  medicine       Medicine        @relation(fields: [medicineId], references: [id])
  medicineId     Int
  quantity       Int
  vendor         Vendor          @relation(fields: [vendorId], references: [id])
  vendorId       Int
  buyingPrice    Decimal
  paymentMethod  PaymentMethod
  deadline       DateTime
  isArrived      Boolean
  is_active      Boolean
  created_at     DateTime
  updated_at     DateTime        @default(now())
  report         MedicineReport? @relation(fields: [reportId], references: [id])
  reportId       Int?
}

model OutputMedicine {
  id               Int             @id @default(autoincrement())
  medicine         Medicine        @relation(fields: [medicineId], references: [id])
  medicineId       Int
  quantity         Int
  reasonOfDispose  ReasonOfDispose
  is_active        Boolean
  created_at       DateTime
  updated_at       DateTime        @default(now())
  report           MedicineReport? @relation(fields: [reportId], references: [id])
  reportId         Int?
  physicalReport   PhysicalReport? @relation(fields: [physicalReportId], references: [id])
  physicalReportId Int?            @unique
}

model MedicineReport {
  id               Int               @id @default(autoincrement())
  receiveMedicines ReceiveMedicine[]
  transactions     Transaction[]
  outputMedicines  OutputMedicine[]
  isFinalized      Boolean
  is_active        Boolean
  created_at       DateTime
  updated_at       DateTime          @default(now())
}

model Pharmacy {
  id          Int      @id @default(autoincrement())
  name        String
  pharmacyNum String
  address     String
  phoneNum    String
  email       String
  created_at  DateTime
  updated_at  DateTime @default(now())
}

model PhysicalReport {
  id             Int             @id @default(autoincrement())
  data           Json
  created_at     DateTime
  transaction    Transaction?
  outputMedicine OutputMedicine?
}

enum Role {
  ADMIN
  DOCTOR
  PHARMACIST
}

enum UnitOfMeasure {
  MILLILITER
  MILLIGRAM
  GRAM
  LITER
  GROS
  KODI
  RIM
  PCS
}

enum Status {
  UNPROCESSED
  WAITING_FOR_PAYMENT
  ON_PROGRESS
  DONE
  CANCELED
}

enum PaymentMethod {
  DEBIT
  CREDIT
  QRIS
  PAYPAL
  CASH
}

enum ReasonOfDispose {
  EXPIRED
  BROKEN
  LOST
}
